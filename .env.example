# NocoDB Configuration
NOCODB_API_URL=https://db.drtunmyatwin.com
NOCODB_LEAD_TABLE_ID=your_lead_table_id_here
NOCODB_BOOKING_TABLE_ID=your_booking_table_id_here
NOCODB_API_TOKEN=your_api_token_here

# Optional Vite/frontend aliases (server also reads these as fallbacks)
# VITE_NOCODB_API_URL=https://db.drtunmyatwin.com
# VITE_NOCODB_TABLE_ID=your_lead_table_id_here
# VITE_NOCODB_API_TOKEN=your_api_token_here
ADMIN_DASHBOARD_KEY=your_strong_admin_key_here
ZOOM_ACCOUNT_ID=your_zoom_account_id_here
ZOOM_CLIENT_ID=your_zoom_client_id_here
ZOOM_CLIENT_SECRET=your_zoom_client_secret_here
# Optional: static OAuth token fallback (server will prefer OAuth credentials above)
ZOOM_ACCESS_TOKEN=
ZOOM_TIMEZONE=Asia/Yangon

# Google Drive (recording upload)
# OAuth (recommended for personal Gmail / My Drive)
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=https://drtunmyatwin.com/api/google-drive/oauth/callback
GOOGLE_OAUTH_REFRESH_TOKEN=

# Service Account (alternative, better with Shared Drive)
GOOGLE_DRIVE_CLIENT_EMAIL=your_service_account_email_here
GOOGLE_DRIVE_PRIVATE_KEY=your_service_account_private_key_here
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here
